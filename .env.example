# คัดลอกเป็น .env แล้วเติมค่าจริง
# .env อยู่ใน .gitignore แล้ว - ห้าม commit
#
# ตอนนี้ดูแลอยู่ 2 เครื่อง ตั้งชื่อ A/B ให้ตรงกับตาราง inventory ใน README

# ---------- เครื่อง A ----------
SERVER_A_IP=x.x.x.x
SERVER_A_HOSTNAME=srvXXXXXXX

# aaPanel - พอร์ตและ path ต้องเปลี่ยนจากค่าเริ่มต้น (8888 / aapadmin)
SERVER_A_PANEL_PORT=
SERVER_A_PANEL_ENTRANCE=
SERVER_A_PANEL_USER=

# ---------- เครื่อง B ----------
SERVER_B_IP=x.x.x.x
SERVER_B_HOSTNAME=

SERVER_B_PANEL_PORT=
SERVER_B_PANEL_ENTRANCE=
SERVER_B_PANEL_USER=

# ---------- ใช้ร่วมกัน ----------
# Offsite backup (Backblaze B2 / Cloudflare R2)
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# SMTP
SMTP_PROVIDER=brevo
SMTP_HOST=
SMTP_USER=
