# คัดลอกเป็น .env แล้วเติมค่าจริง
# .env อยู่ใน .gitignore แล้ว - ห้าม commit
#
# ถ้ามีหลายเครื่อง ทำ .env แยกไฟล์ต่อเครื่อง (.env.<ชื่อเครื่อง>) อย่ายัดรวมไฟล์เดียว
# เพราะคำสั่งส่วนใหญ่ในคู่มือนี้ทำงานทีละเครื่อง

SERVER_IP=x.x.x.x
SERVER_HOSTNAME=srvXXXXXXX

# aaPanel - พอร์ตและ path ต้องเปลี่ยนจากค่าเริ่มต้น (8888 / aapadmin)
AAPANEL_PORT=
AAPANEL_ENTRANCE=
AAPANEL_USER=

# Offsite backup (Backblaze B2 / Cloudflare R2)
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# SMTP
SMTP_PROVIDER=brevo
SMTP_HOST=
SMTP_USER=
