# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์จริง  (.env ถูก gitignore ไว้แล้ว)
# ขอคีย์ที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# ไม่บังคับ - ยิงคำขอ RDAP (เช็ควันจดโดเมน) ผ่าน proxy
# ทะเบียนโดเมนจำกัดจำนวนคำขอต่อ IP หนัก ถ้าเช็คเยอะจะโดนบล็อก
# รองรับ http/https/socks5 เช่น http://user:pass@1.2.3.4:8080
PROXY_URL=

# proxy ใส่เป็นไฟล์แทน env ได้ (แนะนำ - รองรับหลายตัว หมุนสลับให้)
#   tools/ct-live/proxies.txt        ใช้กับ RDAP        IP ที่ไหนก็ได้
#   tools/ct-live/proxies-probe.txt  ใช้เปิดหน้าเว็บ    ห้ามใช้ IP ไทย (ISP บล็อก)
